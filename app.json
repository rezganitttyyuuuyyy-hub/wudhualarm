{
  "expo": {
    "name": "WudhuAlarm",
    "slug": "wudhualarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wudhualarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wudhualarm.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "WudhuAlarm uses the camera to verify prayer completion.",
        "NSLocationWhenInUseUsageDescription": "WudhuAlarm needs your location to calculate accurate prayer times for your area.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.wudhualarm.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-camera", { "cameraPermission": "WudhuAlarm uses the camera to verify prayer completion." }],
      ["expo-notifications", { "icon": "./assets/images/icon.png", "color": "#0D9488" }],
      ["expo-location", { "locationWhenInUsePermission": "WudhuAlarm needs your location to calculate accurate prayer times." }],
      ["expo-build-properties", {
        "android": {
          "compileSdkVersion": 35,
          "targetSdkVersion": 35,
          "minSdkVersion": 24,
          "buildToolsVersion": "35.0.0",
          "kotlinVersion": "1.9.25",
          "enableJetifier": true,
          "packagingOptions": { "pickFirst": ["lib/**/libc++_shared.so", "lib/**/libfbjni.so"] }
        },
        "ios": { "deploymentTarget": "15.1" }
      }],
      ["react-native-google-mobile-ads", {
        "androidAppId": "ca-app-pub-6771546681551540~3934071182",
        "iosAppId": "ca-app-pub-6771546681551540~3934071182"
      }],
      "./plugins/withFixedGoogleMobileAds"
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "2cf31e29-2bc7-4e02-b1b4-b9089d8dbc6a" } },
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/2cf31e29-2bc7-4e02-b1b4-b9089d8dbc6a" }
  }
        }
